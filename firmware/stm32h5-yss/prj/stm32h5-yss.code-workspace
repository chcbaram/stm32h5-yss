{
  "folders": [
    {
      "name": "stm32h5-yss",
      "path": "../"
    }
  ],
  "settings": {
    "C_Cpp.autoAddFileAssociations": false,
    "files.exclude": {
      "**/.DS_Store": true,
      "**/prj": true,
      "**/Thumbs.db": true
    },
    "search.exclude": {
      "**/build": true,
      "lib/st": true
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-arm"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build-configure",
        "type": "process",
        "command": "cmake",
        "args": [
          "-S",
          ".",
          "-B",
          "build",
          "-G",
          "Ninja"
        ],
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "build-build",
        "type": "process",
        "command": "cmake",
        "args": [
          "--build",
          "build",
          "-j8"
        ],
        "problemMatcher": [
          "$gcc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "dependsOn": "build-configure",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "build-clean",
        "type": "process",
        "command": "cmake",
        "args": [
          "--build",
          "build",
          "--target",
          "clean"
        ],
        "problemMatcher": [],
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "flash",
        "type": "process",
        "command": "cmake",
        "args": [
          "--build",
          "build",
          "--target",
          "flash"
        ],
        "problemMatcher": [],
        "dependsOn": "build-build",
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "gdb-server",
        "detail": "probe-rs gdb 서버 (cortex-debug 런처용). 디버그가 끝나면 gdb-server-stop 이 끈다.",
        "type": "process",
        "command": "probe-rs",
        "args": [
          "gdb",
          "--chip",
          "STM32H563VITx",
          "--gdb-connection-string",
          "127.0.0.1:1337"
        ],
        "isBackground": true,
        "problemMatcher": {
          "owner": "probe-rs",
          "pattern": {
            "regexp": "^__never_matches__$"
          },
          "background": {
            "activeBegin": true,
            "beginsPattern": ".",
            "endsPattern": "Firing up GDB stub"
          }
        },
        "options": {
          "cwd": "${workspaceFolder}"
        }
      },
      {
        "label": "debug-prepare",
        "dependsOrder": "sequence",
        "dependsOn": [
          "build-build",
          "gdb-server"
        ],
        "problemMatcher": []
      },
      {
        "label": "gdb-server-stop",
        "detail": "gdb-server 태스크를 끈다. 서버가 남으면 프로브를 잡고 있어 flash 가 실패한다.",
        "type": "process",
        "command": "cmake",
        "args": [
          "-E",
          "echo",
          "${input:terminateGdbServer}"
        ],
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "terminateGdbServer",
        "type": "command",
        "command": "workbench.action.tasks.terminate",
        "args": "gdb-server"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug (main 에서 멈춤)",
        "type": "cortex-debug",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "executable": "${workspaceFolder}/build/stm32h5-yss.elf",
        "servertype": "external",
        "gdbTarget": "127.0.0.1:1337",
        "gdbPath": "arm-none-eabi-gdb",
        "preLaunchTask": "debug-prepare",
        "postDebugTask": "gdb-server-stop",
        "overrideLaunchCommands": [
          "monitor reset halt",
          "load",
          "monitor reset halt"
        ],
        "overrideRestartCommands": [
          "monitor reset halt"
        ],
        "runToEntryPoint": "main",
        "svdFile": "${workspaceFolder}/tools/svd/STM32H563.svd",
        "showDevDebugOutput": "none"
      },
      {
        "name": "Debug (probe-rs, 리셋에서 멈춤)",
        "type": "probe-rs-debug",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "chip": "STM32H563VITx",
        "preLaunchTask": "build-build",
        "flashingConfig": {
          "flashingEnabled": true,
          "verifyBeforeFlashing": true,
          "verifyAfterFlashing": true,
          "haltAfterReset": true
        },
        "coreConfigs": [
          {
            "coreIndex": 0,
            "programBinary": "${workspaceFolder}/build/stm32h5-yss.elf",
            "svdFile": "${workspaceFolder}/tools/svd/STM32H563.svd"
          }
        ]
      },
      {
        "name": "Attach (probe-rs)",
        "type": "probe-rs-debug",
        "request": "attach",
        "cwd": "${workspaceFolder}",
        "chip": "STM32H563VITx",
        "coreConfigs": [
          {
            "coreIndex": 0,
            "programBinary": "${workspaceFolder}/build/stm32h5-yss.elf",
            "svdFile": "${workspaceFolder}/tools/svd/STM32H563.svd"
          }
        ]
      }
    ]
  }
}
